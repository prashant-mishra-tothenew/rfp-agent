# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:32b
LLM_FAST_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
PIPELINE_CONCURRENCY=3
RETRIEVAL_SCORE_THRESHOLD=0.55
ANALYZER_MAX_CHARS=20000
RESPONSE_BATCH_SIZE=3
RESPONSE_EVIDENCE_ITEMS=3
RESPONSE_EVIDENCE_CHARS=600
RESPONSE_MAX_TOKENS=400
PROPOSAL_CONCURRENCY=3
PROPOSAL_MAX_TOKENS=500
PROPOSAL_RESPONSE_CHARS=150
PROPOSAL_MAX_RESPONSES=25
PROPOSAL_GENERATE_PDF=true

# Services
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:3001
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Paths
DATABASE_PATH=./data/rfp.db
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_FILE_BYTES=52428800
PROPOSAL_DIR=./data/proposals
PPTX_TEMPLATE_PATH=./templates/proposal-template.pptx
